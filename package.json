{
  "name": "univer-api",
  "version": "0.1.0",
  "private": true,
  "description": "One Univer Facade API reference contract for browsers, Node.js servers, and CLIs.",
  "type": "module",
  "bin": {
    "univer-api": "./dist/node/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/web/api.js",
      "import": "./dist/node/index.js"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "import": "./dist/node/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/build.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "cli": "tsx src/cli.ts",
    "dev": "tsx watch src/server.ts",
    "server": "node dist/node/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@univer-cli/api-reference": "1.0.0-rc.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.22.0"
}
